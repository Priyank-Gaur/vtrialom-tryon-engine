{
  "compilerOptions": {
    // Target modern browsers — no need to transpile to ES5
    "target": "ESNext",
    "useDefineForClassFields": true,

    // DOM types required for canvas, webcam, requestAnimationFrame, etc.
    "lib": ["DOM", "DOM.Iterable", "ESNext"],

    // Module system
    "module": "ESNext",
    "moduleResolution": "bundler",

    // Paths & resolution
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,

    // Emit — Vite handles bundling, TypeScript only type-checks
    "noEmit": true,
    "isolatedModules": true,

    // Strictness — required for production-quality code
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Skip type-checking of node_modules declaration files
    "skipLibCheck": true,

    // Source maps for debugging
    "sourceMap": true
  },
  "include": ["src", "tests", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}

